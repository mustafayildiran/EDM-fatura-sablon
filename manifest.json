{
  "manifest_version": 3,
  "name": "EDM Fatura Hızlı Doldurma",
  "version": "1.6.0",
  "description": "EDM e-Fatura portalı manuel fatura ekranında Mal/Hizmet satırlarını ve Notları tek tıkla doldurur.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://portal4.edmbilisim.com.tr/*",
    "https://*.edmbilisim.com.tr/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal4.edmbilisim.com.tr/EFaturaUI/Invoice/ManualInvoiceEdit*",
        "https://*.edmbilisim.com.tr/EFaturaUI/Invoice/ManualInvoiceEdit*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EDM Hızlı Ürün",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "popup.html"
}
